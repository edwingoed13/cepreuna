# Configuración de la API interna. Copiar a `.env` DENTRO de esta carpeta.
# El servicio lee este archivo por ruta absoluta, así que no depende del cwd
# con el que se arranque (pm2, systemd o manual).

API_PORT=3001

# Generar en el servidor: openssl rand -hex 32
# El servicio no arranca sin este valor, para no quedar expuesto por descuido.
API_INTERNA_TOKEN=

# Base multiciclo (red interna). Cuenta de SOLO LECTURA.
DB2_HOST=10.1.30.44
DB2_PORT=3306
DB2_USER=cepre_viewer
# Entre comillas: la contraseña contiene '#' y sin ellas dotenv la corta ahí.
DB2_PASSWORD=""
DB2_NAME=cepreuna_multiciclo
