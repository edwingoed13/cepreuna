# Ejemplo de variables de entorno
# Copia este archivo a .env.local para desarrollo local

# URL del API Backend
VITE_API_URL=https://backend-cepreuna-2025-production.up.railway.app/api

# Base de datos MySQL usada por server.js
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cepreuna
DB_USER=cepreuna
DB_PASSWORD=cambia-esta-clave

# Token JWT de apisperu (consulta de RUC). Obtener en https://apis.net.pe / apisperu.com
APISPERU_TOKEN=tu-token-jwt-aqui

# URL del Google Apps Script del forms-admin (despliegue /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec

# Secreto para firmar los JWT del panel /stats. OBLIGATORIO en producción.
# Si falta en producción se genera uno EFÍMERO por instancia → las sesiones se
# invalidan al navegar (401) en entornos serverless/multi-instancia (Vercel).
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Orígenes permitidos para CORS (separados por coma). Opcional.
# CORS_ORIGINS=https://cepreuna.info,https://www.cepreuna.info
